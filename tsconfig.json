{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "noEmit": true,
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "typeRoots": [
      "src/types",
      "node_modules/@types"
    ],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "obsidian": ["./node_modules/obsidian"]
    },
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2018"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../node_modules",
    "tests",
    "src/tests/**",
    "src/__tests__/**/*",
    "**/__tests__/**/*",
    "**/*.test.ts",
    "research/**"
  ]
}
